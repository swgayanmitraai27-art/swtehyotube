rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & settings
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
      
      // Sensitive OAuth tokens subcollection - strictly restricted to owner
      match /tokens/{tokenDoc} {
        allow read, write: if isOwner(userId);
      }
      
      // Auto-pilot logs & reply history subcollection
      match /replies/{replyDoc} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }
    
    // System transaction logs (created via server admin SDK on Razorpay webhook)
    match /transactions/{txId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Only Admin SDK can write
    }
    
    // Global cached comment threads
    match /comments_cache/{cacheId} {
      allow read, write: if isAuthenticated();
    }
  }
}
